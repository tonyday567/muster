cabal-version:      3.16
-- The cabal-version field refers to the version of the cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the cabal-version: 3.16 field must be the first thing in this file.
--
-- Initial package description 'muster' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               muster

-- The package version.
-- See the package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
synopsis:           Ad-hoc multiplicity events over the bus

-- A longer description of the package.
-- description:

-- URL for the project homepage or repository.
homepage:           https://github.com/tonyday567/muster

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Tony Day

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         tonyday567@gmail.com

-- A copyright notice.
-- copyright:
category:           Concurrency
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial file.
extra-source-files: app/deck.html

common warnings
    ghc-options: -Wall

library
    import:           warnings

    exposed-modules:
        Muster.Api.Types
        Muster.Api.Bus
        Muster.Api.Participant
        Muster.Api.Agent
        Muster.Api.Orchestrator
        Muster.Bus
        Muster.Channel
        Muster.Cli.Opts
        Muster.Config
        Muster.Cursor
        Muster.Framing
        Muster.Agent
        Muster.Agent.Seat
        Muster.Connector
        Muster.Diagram
        Muster.Ws

    build-depends:
        base,
        async,
        bytestring,
        chart-svg,
        circuits >=0.1.0.0 && <0.4,
        circuits-agent,
        circuits-parser,
        containers,
        directory,
        filepath,
        free-agent,
        http-types,
        optparse-applicative,
        process,
        stm,
        string-diagrams,
        strings-svg,
        text,
        time,
        unix,
        vector,
        wai,
        wai-websockets,
        websockets

    hs-source-dirs:   src

    default-language: GHC2021

executable muster
    -- Import common warning flags.
    import:           warnings

    -- .hs or .lhs file containing the Main module.
    main-is:          Muster.hs

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:
        base,
        muster,
        optparse-applicative,
        text,
        time,
        directory,
        filepath,
        process,
        unix

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: GHC2021

executable muster-agent
    import:           warnings

    main-is:          MusterAgent.hs

    build-depends:
        base,
        muster,
        circuits-agent,
        optparse-applicative,
        text,
        async,
        containers,
        directory,
        filepath,
        process,
        stm

    hs-source-dirs:   app

    default-language: GHC2021

executable muster-seat-verify
    import:           warnings

    main-is:          seat-verify.hs

    build-depends:
        base,
        directory,
        muster,
        text

    hs-source-dirs:   app

    default-language: GHC2021

-- Manual hermes smoke for a single live seat. Not CI / not observe pipelines.
executable muster-hermes-seat-smoke
    import:           warnings

    main-is:          hermes-seat-smoke.hs

    build-depends:
        base,
        directory,
        muster,
        text

    hs-source-dirs:   app

    default-language: GHC2021

-- Multi-round dialogue smoke: pure–pure (default), pure–hermes, hermes–hermes.
-- Not CI; hermes tiers exit 2 if hermes missing/fails.
executable muster-multi-round-smoke
    import:           warnings

    main-is:          multi-round-smoke.hs

    build-depends:
        base,
        directory,
        muster,
        text

    hs-source-dirs:   app

    default-language: GHC2021

-- Composed seat pipeline smoke (no hermes, no live bus daemon).
executable muster-agent-pipeline-smoke
    import:           warnings

    main-is:          agent-pipeline-smoke.hs

    build-depends:
        base,
        circuits-agent,
        directory,
        filepath,
        muster,
        async,
        containers,
        stm,
        text

    hs-source-dirs:   app

    default-language: GHC2021

-- Bus-as-topology smoke: panel of experts + synthesizer on a shared log.
executable muster-bus-composition-smoke
    import:           warnings

    main-is:          bus-composition-smoke.hs

    build-depends:
        base,
        directory,
        muster,
        text

    hs-source-dirs:   app

    default-language: GHC2021

-- Panel topology smoke: N agents × R rounds + synthesis.
executable muster-panel-smoke
    import:           warnings

    main-is:          panel-smoke.hs

    build-depends:
        base,
        directory,
        muster,
        text

    hs-source-dirs:   app

    default-language: GHC2021

executable muster-ws
    import:           warnings

    main-is:          MusterWs.hs

    ghc-options: -threaded -rtsopts -with-rtsopts=-N

    build-depends:
        base,
        bytestring,
        file-embed,
        muster,
        optparse-applicative,
        text,
        directory,
        filepath,
        warp

    hs-source-dirs:   app

    default-language: GHC2021

-- Structural oracle for the muster-ws refactor (launch L1): two clients,
-- exactly-once delivery, no history/live gap, visible post failure.
executable muster-ws-smoke
    import:           warnings

    main-is:          ws-smoke.hs

    ghc-options: -threaded

    build-depends:
        base,
        async,
        bytestring,
        circuits-parser,
        directory,
        filepath,
        muster,
        process,
        stm,
        text,
        warp,
        websockets

    hs-source-dirs:   app

    default-language: GHC2021

executable cabal-repl-muster
    import:           warnings

    main-is:          CabalReplMuster.hs

    build-depends:
        base,
        muster,
        directory,
        filepath,
        text

    hs-source-dirs:   app

    default-language: GHC2021

executable muster-alert
    import:           warnings

    main-is:          MusterAlert.hs

    build-depends:
        base,
        muster,
        text,
        directory,
        filepath,
        unix

    hs-source-dirs:   app

    default-language: GHC2021

test-suite muster-doctest
    import:           warnings

    type:             exitcode-stdio-1.0
    main-is:          Doctest.hs
    build-depends:
        base,
        doctest,
        muster

    hs-source-dirs:   test
    default-language: GHC2021

test-suite muster-test
    import:           warnings

    type:             exitcode-stdio-1.0
    main-is:          Test.hs
    build-depends:
        base,
        muster,
        tasty,
        tasty-hunit,
        text,
        directory,
        filepath,
        process,
        temporary

    hs-source-dirs:   test
    default-language: GHC2021
